MSSQL_SA_PASSWORD=<strong-sa-password>
APP_DB_PASSWORD=<strong-app-password>
RABBITMQ_PASSWORD=<strong-rabbitmq-password>
# Identity signing key (base64 PKCS#8) and its public half (base64 SubjectPublicKeyInfo)
JWT_SIGNING_KEY=<base64-pkcs8-private-key>
JWT_PUBLIC_KEY=<base64-public-key>
# Optional: build the portal from a local checkout instead of GitHub
# WEB_BUILD_CONTEXT=../invoice-tracker-web
