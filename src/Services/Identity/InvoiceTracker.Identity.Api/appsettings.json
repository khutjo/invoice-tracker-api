{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "invoice-tracker-identity",
    "Audience": "invoice-tracker-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "KeyId": "identity-2026-10"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "invoice-tracker",
    "ClientName": "identity"
  },
  "Portal": {
    "BaseUrl": "http://localhost:8080",
    "VerifyEmailPath": "/verify-email"
  }
}
