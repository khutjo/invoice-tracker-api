{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "invoice-tracker-identity",
    "Audience": "invoice-tracker-api"
  },
  "LogoStorage": {
    "RootPath": "App_Data/logos"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "invoice-tracker",
    "ClientName": "business"
  }
}
