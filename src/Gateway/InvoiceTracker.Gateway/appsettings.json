{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**rest}"
        }
      },
      "business": {
        "ClusterId": "business",
        "Match": {
          "Path": "/api/v1/business/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "business": {
        "Destinations": {
          "business": {
            "Address": "http://business:8080/"
          }
        }
      }
    }
  }
}
