{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Portal": {
    "BaseUrl": "http://localhost:9000"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**rest}"
        }
      },
      "business": {
        "ClusterId": "business",
        "Match": {
          "Path": "/api/v1/business/{**rest}"
        }
      },
      "customers": {
        "ClusterId": "business",
        "Match": {
          "Path": "/api/v1/customers/{**rest}"
        }
      },
      "invoices": {
        "ClusterId": "invoicing",
        "Match": {
          "Path": "/api/v1/invoices/{**rest}"
        }
      },
      "dashboard": {
        "ClusterId": "invoicing",
        "Match": {
          "Path": "/api/v1/dashboard/{**rest}"
        }
      },
      "admin-jobs": {
        "ClusterId": "invoicing",
        "Match": {
          "Path": "/api/v1/admin/jobs/{**rest}"
        }
      },
      "payment-webhooks": {
        "ClusterId": "invoicing",
        "Match": {
          "Path": "/api/v1/webhooks/payments/{**rest}"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/v1/notifications/{**rest}"
        }
      },
      "notifications-hub": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/hubs/notifications/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "business": {
        "Destinations": {
          "business": {
            "Address": "http://business:8080/"
          }
        }
      },
      "invoicing": {
        "Destinations": {
          "invoicing": {
            "Address": "http://invoicing:8080/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "notification": {
            "Address": "http://notification:8080/"
          }
        }
      }
    }
  }
}
